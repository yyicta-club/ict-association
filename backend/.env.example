# ---------- 服务 ----------
# 后端端口（3000 留给 Nuxt 前端）
PORT=8787
# development | production | test
NODE_ENV=development

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ict_association
# 连接池上限
DB_CONNECTION_LIMIT=10

# ---------- JWT ----------
# 必填：>= 32 位随机字符串，缺失时服务拒绝启动
# 生成方式：bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex'))"
JWT_SECRET=
# 有效期，支持 30s / 30m / 12h / 7d / 2w 或纯秒数
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
# 逗号分隔的来源白名单
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- 静态资源上传 ----------
# 上传根目录（必须是绝对路径）。分类子目录与文件都写在该目录下。
# Windows 示例：
STATIC_FILE_PATH=D:\upload
# Linux 部署示例：
# STATIC_FILE_PATH=/var/lib/ict-association/uploads
# 上传限流：固定窗口 60 秒内最多 10 次（两个上传入口共享同一 IP 配额）
STATIC_FILE_RATE_WINDOW_MS=60000
STATIC_FILE_RATE_MAX=10

# ---------- 可信代理 ----------
# 逗号分隔的可信代理 IP / CIDR；留空表示不信任任何代理（转发头一律忽略）。
# 只有当连接的对端地址命中该列表时，才会采信 X-Forwarded-For / X-Real-IP。
# 示例：TRUSTED_PROXIES=10.0.0.0/8,192.168.1.1
TRUSTED_PROXIES=

# ---------- 初始管理员（仅 seed:admin 脚本使用）----------
ADMIN_INIT_USERNAME=admin
# 至少 8 位；留空则必须通过 --password=xxx 传入
ADMIN_INIT_PASSWORD=
